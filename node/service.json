{
  "memory": 256,
  "ttl": 10,
  "timeout": 2,
  "minReplicas": 2,
  "maxReplicas": 4,
  "workers": 1,

  "routes": {
    "status": {
      "path": "/_v/statusgtme/:code",
      "public": true
    },
    "settings": {
      "path": "/_v/settings",
      "public": true
    },
    "trastyTest": {
      "path": "/_v/trasty/test",
      "public": true
    }
  },
  "events": {
    "onSettingsChanged": {
      "sender": "apps",
      "keys": ["settings"]
    },
    "onPaymentApproved": {
      "sender": "vtex.orders-broadcast",
      "topics": ["payment-approved"]
    }
  }
}
